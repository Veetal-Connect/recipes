# Your Veetal Connect API key — dashboard.veetal.app → Developers → Authentication
VEETAL_API_KEY=

# The slug the API identifies your hotel by. The copy icon next to the hotel in
# Accommodation Rates → Accommodations gives it to you.
VEETAL_ACCOMMODATION_SLUG=

# Only if you are pointed at a non-production API.
# VEETAL_API_URL=https://api.veetal.app/v2
